				"languages": {
					"en": "//(0,30)\\\\When in doubt, aim for the head.",
					"fr": "//(0,30)\\\\En cas de doute, toujours viser la tête.",
					"it": "//(0,30)\\\\In caso di dubbi, mira alla testa.",
					"de": "//(0,30)\\\\Im Zweifelsfall immer auf den Kopf zielen.",
					"es": "//(0,30)\\\\En caso de duda, apunta a la cabeza.",
					"ru": "//(0,30)\\\\Если сомневаешься, целься в голову.",
					"cn": "//(0,30)\\\\举棋不定时，打头就对了。",
					"tc": "//(0,30)\\\\有疑慮時就瞄準頭部。",
					"jp": "//(0,30)\\\\迷ったら、頭を狙う。"
				}
			},
