				"languages": {
					"en": "//(0,30)\\\\He never saw that coming.",
					"fr": "//(0,30)\\\\Il ne l'a pas vue venir.",
					"it": "//(0,30)\\\\Non se l'aspettava.",
					"de": "//(0,30)\\\\Er hat nichts geahnt.",
					"es": "//(0,30)\\\\Ni se ha enterado.",
					"ru": "//(0,30)\\\\Он и моргнуть не успел.",
					"cn": "//(0,30)\\\\他都不知道自己怎么死的。",
					"tc": "//(0,30)\\\\他完全沒料到。",
					"jp": "//(0,30)\\\\気付く間もなかっただろう。"
				}
			},
