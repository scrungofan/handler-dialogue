				"languages": {
					"en": "//(0,30)\\\\Clean kill.",
					"fr": "//(0,30)\\\\Une élimination propre.",
					"it": "//(0,30)\\\\Un'uccisione pulita.",
					"de": "//(0,30)\\\\Sauberer Abschuss.",
					"es": "//(0,30)\\\\Una muerte limpia.",
					"ru": "//(0,30)\\\\Чисто сработано.",
					"cn": "//(0,30)\\\\这一枪干净利落。",
					"tc": "//(0,30)\\\\乾淨俐落的擊殺。",
					"jp": "//(0,30)\\\\命中だ。"
				}
			},
