				"languages": {
					"en": "//(0,30)\\\\Never knew what hit him.",
					"fr": "//(0,30)\\\\Il ne saura jamais ce qui l'a frappé.",
					"it": "//(0,30)\\\\Non se n'è nemmeno accorto.",
					"de": "//(0,30)\\\\Das hat er wohl nicht kommen sehen.",
					"es": "//(0,30)\\\\Ni se ha enterado.",
					"ru": "//(0,30)\\\\Он даже не понял, что произошло.",
					"cn": "//(0,30)\\\\他都不知道自己怎么死的。",
					"tc": "//(0,30)\\\\他怎麼死的都不知道。",
					"jp": "//(0,30)\\\\何が起きたかも分からなかっただろうな。"
