				"languages": {
					"en": "//(0,30)\\\\Quickest way to take them down.",
					"fr": "//(0,30)\\\\Rien de tel pour les éliminer rapidement.",
					"it": "//(0,30)\\\\Il modo migliore per farli fuori.",
					"de": "//(0,30)\\\\Der schnellste Weg, sie auszuschalten.",
					"es": "//(0,30)\\\\Es el modo más rápido de eliminarlos.",
					"ru": "//(0,30)\\\\Самый быстрый способ.",
					"cn": "//(0,30)\\\\这是消灭目标最快的方式。",
					"tc": "//(0,30)\\\\解決掉他們最快的方法。",
					"jp": "//(0,30)\\\\最速の方法だ。"
				}
			},
