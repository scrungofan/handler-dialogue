				"languages": {
					"en": "//(0,30)\\\\Guess my recent hunting trips have been paying off.",
					"fr": "//(0,30)\\\\Mes dernières parties de chasse ont servi, on dirait.",
					"it": "//(0,30)\\\\A quanto pare le mie ultime battute di caccia sono servite a qualcosa.",
					"de": "//(0,30)\\\\Schätze, meine letzten Jagdausflüge haben sich ausgezahlt.",
					"es": "//(0,30)\\\\Veo que has aprendido algo de mis últimas cacerías.",
					"ru": "//(0,30)\\\\Похоже, не зря я тренировался на охоте.",
					"cn": "//(0,30)\\\\看来我最近几次猎没有白打。",
					"tc": "//(0,30)\\\\我看我最近的狩獵之旅還是有幫助的。",
					"jp": "//(0,30)\\\\最近狩りで腕を鍛えてたのが良かったらしい。"
				}
			},
			{
				"type": "WavFile",
				"wavName": "dr20055_mp_headshot_stone_stone_002",
				"weight": 0.14285714285714285,
				"soundtag": "Voiceover_Handler_ICAEarpiece",
				"defaultWav": "[assembly:/sound/wwise/originals/voices/english(us)/sniper_maps/global/global_20000_story/dr20055_mp_headshot_stone_stone_002.wav].pc_wes",
				"defaultFfx": "[assembly:/_pro/facefx/exported_animation/english(us)/sniper_maps/global/global_20000_story/dr20055_mp_headshot_stone_stone_002.animset].pc_animset",
				"languages": {
					"en": "//(0,30)\\\\Don't hate me because I'm good.",
					"fr": "//(0,30)\\\\Ne me déteste pas parce que je suis bon.",
					"it": "//(0,30)\\\\Non odiarmi solo perché sono bravo.",
					"de": "//(0,30)\\\\Kein Neid auf mein Können bitte.",
					"es": "//(0,30)\\\\No me odies por ser tan bueno.",
					"ru": "//(0,30)\\\\Завидуй молча.",
					"cn": "//(0,30)\\\\别因为我太厉害而心生嫉妒哦。",
					"tc": "//(0,30)\\\\別嫉妒我的才華。",
					"jp": "//(0,30)\\\\俺が上手いからって憎むなよ。"
				}
			},
			{
				"type": "WavFile",
				"wavName": "dr20055_mp_headshot_stone_stone_003",
