				"languages": {
					"en": "//(0,30)\\\\May not be the easiest shot but it sure is the most gratifying one.",
					"fr": "//(0,30)\\\\Ce n'est pas le tir le plus simple, mais c'est le plus gratifiant.",
					"it": "//(0,30)\\\\Non sarà il tiro più semplice, ma di certo è il più gratificante.",
					"de": "//(0,30)\\\\Es mag zwar kein leichter Schuss gewesen sein, aber zweifelsohne war es ein befriedigender.",
					"es": "//(0,30)\\\\Puede que no sea el tiro más fácil, pero sin duda es el más satisfactorio.",
					"ru": "//(0,30)\\\\Не самый простой выстрел, но мне понравилось.",
					"cn": "//(0,30)\\\\这一枪虽然有些难度，但满足感无与伦比。",
					"tc": "//(0,30)\\\\這一槍或許不是很簡單，不過卻是非常令人滿足。",
					"jp": "//(0,30)\\\\成功は難しいけど、決まれば最高。"
				}
			},
